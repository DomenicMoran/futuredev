# Werkzeuge auf dem Rechner (tools/audio, tools/publish). Diese Werte
# landen NIE im App-Bündel und NIE im Repo. Datei ausfüllen, als .env.local
# lokal ablegen, nie committen.

# tools/audio: liest den ElevenLabs-Schlüssel, um Sprechblöcke zu vertonen.
ELEVENLABS_API_KEY=
# tools/audio: Stimme für Sprecher A (erklärt).
VOICE_ID_ERKLAERT=
# tools/audio: Stimme für Sprecher B (fragt, wiederholt den Kernsatz).
VOICE_ID_FRAGT=

# tools/publish, supabase/: Projekt-URL für administrative Aufrufe vom Rechner aus.
SUPABASE_URL=
# tools/publish, supabase/: Dienstschlüssel mit vollen Rechten, nur für Werkzeuge
# auf dem Rechner. Niemals in die App, niemals in EXPO_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# apps/mobile: wird zur Bauzeit ins App-Bündel eingebettet und ist damit
# öffentlich lesbar. Nur Werte eintragen, die für jeden Betrachter der APK
# unbedenklich sind (Projekt-URL, anonymer Schlüssel mit RLS-Schutz).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# apps/mobile: Basis-URL, unter der die App Manifest und Inhalte lädt
# (Supabase-Storage-Eimer content/audio, später Cloudflare R2).
EXPO_PUBLIC_CONTENT_BASE_URL=

# tools/publish: Zugang zum Cloudflare-R2-Eimer futuredev-audio (ab Phase 4).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
