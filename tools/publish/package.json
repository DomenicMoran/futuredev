{
  "name": "@futuredev/tools-publish",
  "version": "0.1.0",
  "private": true,
  "description": "Veroeffentlicht content/manifest.json, Lektionen und Hoerdateien in den Supabase-Storage-Eimern content und audio",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "publish:content": "tsx src/publish.ts"
  },
  "dependencies": {
    "@futuredev/content-schema": "workspace:*",
    "@supabase/supabase-js": "2.116.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
