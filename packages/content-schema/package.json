{
  "name": "@futuredev/content-schema",
  "version": "0.1.0",
  "private": true,
  "description": "Zod-Schema fuer Lektionen und Manifest, Pruefregeln, CLI zur Inhaltsvalidierung",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "validate": "tsx src/cli-validate.ts",
    "manifest": "tsx src/cli-manifest.ts"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
